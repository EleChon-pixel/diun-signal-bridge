# Copy to .env and chmod 600 .env; never commit the actual file.
SIGNAL_NUMBER=+10000000000
SIGNAL_RECIPIENTS=+10000000001,+10000000002
# Generate a random token with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
BRIDGE_WEBHOOK_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
